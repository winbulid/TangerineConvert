<!--
  Tangerine.App: the Avalonia desktop application (tray, donut toolbar, settings window).
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Tangerine</AssemblyName>
    <RootNamespace>Tangerine.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Icons\tangerine.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tangerine.Core\Tangerine.Core.csproj" />
    <ProjectReference Include="..\Tangerine.Engines\Tangerine.Engines.csproj" />
    <ProjectReference Include="..\Tangerine.Platform.Windows\Tangerine.Platform.Windows.csproj" />
    <ProjectReference Include="..\Tangerine.Platform.Linux\Tangerine.Platform.Linux.csproj" />
    <ProjectReference Include="..\Tangerine.Platform.MacOS\Tangerine.Platform.MacOS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="SharpHook" />
  </ItemGroup>

  <PropertyGroup>
    <TangerineNativeWayland Condition="$(RuntimeIdentifier.StartsWith('linux')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Linux')))">true</TangerineNativeWayland>
    <DefineConstants Condition="'$(TangerineNativeWayland)' == 'true'">$(DefineConstants);TANGERINE_NATIVE_WAYLAND</DefineConstants>
  </PropertyGroup>

  <!-- Linux-only Wayland packages to keep Windows and macOS binaries small -->
  <ItemGroup Condition="'$(TangerineNativeWayland)' == 'true'">
    <PackageReference Include="Avalonia.Wayland" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- Shown on the About page. -->
    <AvaloniaResource Include="..\..\THIRD-PARTY-NOTICES.md" Link="Assets\THIRD-PARTY-NOTICES.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tangerine.App.Tests" />
  </ItemGroup>

  <!-- Native debug symbols from NuGet packages (SkiaSharp, HarfBuzz: ~100 MB) are useless to users. -->
  <Target Name="TangerineRemoveNativeSymbols" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <_TangerineNativePdb Include="$(PublishDir)lib*.pdb" />
    </ItemGroup>
    <Delete Files="@(_TangerineNativePdb)" />
  </Target>

  <!-- Repository URL for the updater / About page, taken from Directory.Build.props. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepositoryUrl</_Parameter1>
      <_Parameter2>$(TangerineRepositoryUrl)</_Parameter2>
    </AssemblyAttribute>
    <!-- Published builds (installer, portable zip) set -p:TangerineRelease=true: only they register Explorer and startup
         entries (UpdateService.IsReleaseBuild), so running from source leaves the user's system alone. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(TangerineRelease)' == 'true'">
      <_Parameter1>TangerineRelease</_Parameter1>
      <_Parameter2>true</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
